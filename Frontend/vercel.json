
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/delete-account",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/support/delete-account",
      "destination": "/delete-account"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy"
    },
    {
      "source": "/terms",
      "destination": "/terms-of-use"
    }
  ]
}
